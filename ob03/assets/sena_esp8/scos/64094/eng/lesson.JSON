xt", "content": "Maybe next time..."}], "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "allowed_attempts": 2}}], "template_override": 1, "id": 11}, {"type": "DWS", "questions": [{"responses": [{"selected": 0, "id": 0, "correct": 1, "_data": [{"type": "text", "content": ""}]}], "_data": [{"type": "question", "contents": [{"type": "pdf", "content": "enpe8n3le03ob03re7pdf01.pdf"}]}], "id": 0}], "stimuli_ids": [], "_data": [{"type": "instructions", "contents": [{"type": "text", "content": "Let me explain data store in DFD."}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "allowed_attempts": 2}}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self-Assessment."}]}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}], "template_override": 1, "id": 12}], "type": "scholar", "stimuli": [{"type": "welcome", "contents": [{}], "_data": [], "template_override": 1, "id": 0}, {"type": "audio", "contents": [{"value": {"coverimg": "enpe8n3le03ob03re2img01.jpg", "images": [{"text": "<span class=\"strong\"> Manager:</span> Hello everyone. Today, John is going to explain the differences between the processes and the data stores in data flow diagrams (DFD). <br/>\n<span class=\"strong\"> John:</span> You can understand this if you analyze a real DFD. Actually, when you see the graphical representation, you will not recognize its parts and differences.", "image": "enpe8n3le03ob03re2img01.jpg", "time": "0", "id": 0}, {"text": "Processes represent the part of the system which modifies the inputs to the outputs. So, you use rectangular boxes if you want to represent them. There are different boxes in a DFD, so you can say they are processes if you see a top stripe that contains an identification number on the left. The numbers generally follow a left to right convention, however, if you write the numbers in order, it doesn't indicate priority or sequence, it is just an identifier. Also, you recognize the process when it has the location and the specific role on the right. <br/>Remember that if you want to name a specific process, you need a suitable active verb like verify or create.", "image": "enpe8n3le03ob03re2img02.jpg", "time": "20000", "id": 1}, {"text": "The store can have temporary or permanent data until it flows. So, you use an open-ended box if you want to represent it. Remember, you can identify the store if you see letters on it. So, you use the letter \u2018M' or \u2018D' if you want to represent it in a computer and you use the letter 'T' if the store is temporary. <br/><br/>Now, as soon as you see a rectangular box, the identifier, the location, and the name, you recognize the process. And as soon as you see the identifier with a letter, and the specific name, you can say it is a data store. But just until you do it, you will understand it.", "image": "enpe8n3le03ob03re2img03.jpg", "time": "61000", "id": 2}], "audiosrc": "enpe8n3le03ob03re2aud01"}, "type": "slideshow"}], "title": "", "id": 1, "template_override": 1, "_data": []}], "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": ""}, {"type": "unit_name", "content": "Data Flow Diagrams, Processes and Data Stores"}, {"type": "position", "content": 3}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 3}, {"type": "level", "content": "A2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use when you talk about data store and processes parts."}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Learning Outcome"}, {"type": "secondary_1", "content": "Participates in simple conversations or simulated situations about the communicative topics for this level through the appropriate use of simple pronunciation aspects, and grammar and vocabulary structures.  Recognizes simple ideas on requirement reports, tools for Object Oriented Programming, and other basic programming tools."}]}, {"type": "background_image", "content": "enpe8n3le03ob03re1img01.jpg"}, {"type": "target_word", "contents": [{"type": "name", "content": "stripe"}, {"type": "definition", "content": "similar to a line which has a remarkable or different color from the surface or background it is placed on "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: You can say they are processes if you see a top stripe that contains an identification number on the left."}, {"type": "audio", "content": "enpe8n3le03ob03aud01"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "convention"}, {"type": "definition", "content": "a symbol or a rule which represents something"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The numbers generally follow a left to right convention."}, {"type": "audio", "content": "enpe8n3le03ob03aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "role"}, {"type": "definition", "content": "the responsibility someone has in a process "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Also, you recognize the process when it has the location and the specific role on the right."}, {"type": "audio", "content": "enpe8n3le03ob03aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "temporary "}, {"type": "definition", "content": "something which lasts for a short period of time"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: The store can have temporary or permanent data until it flows."}, {"type": "audio", "content": "enpe8n3le03ob03aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "open-ended "}, {"type": "definition", "content": "when something does not have a specific limit"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: You use an open-ended box if you want to represent it."}, {"type": "audio", "content": "enpe8n3le03ob03aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "suitable"}, {"type": "definition", "content": "when something is appropriate for an objective"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: You need a suitable active verb like verify or create."}, {"type": "audio", "content": "enpe8n3le03ob03aud06"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Find out more information about data stores and processes. "}, {"type": "text", "content": "Design a flyer and describe all the information you find. Add some pictures with samples of DFD."}, {"type": "text", "content": "Share your work with your classmates and check pronunciation with your instructor. "}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I look for additional information about data stores and processes."}, {"type": "text", "content": "I express information through a flyer."}, {"type": "text", "content": "I share information with a partner."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Zero Conditional Starting With The Main Clause"}, {"type": "describer", "content": "You use the <span class=\"strong\"> zero conditional </span> to talk about situations that are always real."}, {"type": "text", "content": "The <span class=\"strong\"> zero conditional </span> has two parts. The \u201cif clause\u201d and the result clause. The first part explains a condition. The second one explains the result, consequence or direct relation to the first condition. <br/><br/>  Sometimes, you can start a <span class=\"strong\"> zero conditional </span> with the result clause, and the meaning does not vary, only the position of both clauses. Remember that you do not have to include the comma when the <span class=\"strong\"> zero conditional </span> starts with the result clause. Let's check this example: <br/><br/>  Example: <br/> <span class=\"italic\"> I <span class=\"strong\"> go </span> to the bank now <span class=\"strong\"> if </span> Alicia <span class=\"strong\"> calls </span> me. </span><br/><br/>  Remember that for <span class=\"strong\"> zero conditional</span>, both sentences need to be in <span class=\"strong\"> simple present</span>, and we always use this to talk about things that are true."}, {"type": "example", "content": "You can understand this if you analyze a real DFD."}, {"type": "example", "content": "So, you use rectangular boxes if you want to represent them."}, {"type": "example", "content": "You can say they are processes if you see a top stripe that contains an identification number on the left."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Agile Modeling"}, {"type": "describer", "content": "<span class=\"strong\"> Agile modeling </span> is a complementary methodology for software development which focuses on modeling a system effectively."}, {"type": "table", "content": "{\"rows\":6,\"columns\":1,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"> <span class=\\\"strong\\\"> PRINCIPLES </span></div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<li> It is easy to model with.</li>  <li> It is open to changes.</li>  <li> It focuses on maximizing customer's investment.</li>  <li> It uses multiple programming models.</li>  <li> It focuses on quality work.</li>  <li> It provides constant customer feedback.</li>  <li> It provides an open and honest communication.</li> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"> <span class=\\\"strong\\\"> VALUES </span></div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"They refer to the values that all members of the team should have.  <li> Communication </li>  <li> Simplicity </li> <li> Risk </li>  <li> Humility </li>\\t\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<div class=\\\"center_text\\\"> <span class=\\\"strong\\\"> PRACTICES </span></div>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"It refers to good practices for the successful implementation of modeling. Some of them are the following:  <li> Active participation of stakeholders.</li> <li> Apply appropriate artifacts.</li> <li> Switch to another device where appropriate. </li> <li> Test models with test codes.</li> <li> Use simple tools to represent models.</li> <li> To have a single source file of information.</li> <li> To create multiple models in parallel </li> <li> To create the content as simple as possible </li> \\\"}\"],\"styles\":\" intro_table_border\"}"}]}]}