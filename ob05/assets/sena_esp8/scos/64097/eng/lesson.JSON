ive", "content": "secondary_1"}], "id": 2}, {"responses": [{"selected": 0, "id": 0, "_data": [{"type": "text", "content": ""}], "correct": 0}, {"selected": 0, "id": 1, "_data": [{"type": "text", "content": "hierarchy"}, {"type": "position_x", "content": 2}, {"type": "position_y", "content": 1}, {"type": "direction", "content": 0}, {"type": "reverse", "content": 0}], "correct": 1}], "_data": [{"type": "question", "contents": [{"type": "text", "content": "hierarchy"}]}, {"type": "objective", "content": "secondary_1"}], "id": 3}, {"responses": [{"selected": 0, "id": 0, "_data": [{"type": "text", "content": ""}], "correct": 0}, {"selected": 0, "id": 1, "_data": [{"type": "text", "content": "complex"}, {"type": "position_x", "content": 4}, {"type": "position_y", "content": 0}, {"type": "direction", "content": 1}, {"type": "reverse", "content": 0}], "correct": 1}], "_data": [{"type": "question", "contents": [{"type": "text", "content": "complex"}]}, {"type": "objective", "content": "secondary_1"}], "id": 4}], "template_override": 1}, {"type": "RSLT", "stimuli_ids": [], "id": 11, "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "allowed_attempts": 2}}], "questions": [{"responses": [{"selected": 0, "id": 0, "_data": [{"type": "text", "content": ""}], "correct": 0}, {"selected": 0, "id": 1, "_data": [{"type": "text", "content": ""}], "correct": 1}], "_data": [{"type": "question", "contents": [{"type": "text", "content": ""}]}], "id": 0}], "template_override": 1}, {"type": "DWS", "stimuli_ids": [], "id": 12, "_data": [{"type": "instructions", "contents": [{"type": "text", "content": "Hierarchy in Data Flow Diagrams"}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "allowed_attempts": 2}}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self-Assessment."}]}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}], "questions": [{"responses": [{"selected": 0, "id": 0, "_data": [{"type": "text", "content": ""}], "correct": 1}], "_data": [{"type": "question", "contents": [{"type": "pdf", "content": "enpe8n3le03ob05re7pdf01.pdf"}]}], "id": 0}], "template_override": 1}], "type": "scholar", "stimuli": [{"_data": [], "contents": [{}], "type": "welcome", "template_override": 1, "id": 0}, {"type": "audio", "contents": [{"value": {"coverimg": "enpe8n3le03ob05re2img01.jpg", "images": [{"text": "<p align=\"justify\"> <span class=\"strong\">Instructor</span>: Before, people didn't organize information in hierarchy diagrams, but analyzers became aware of the advantages of representing processes in a chain of command. For instance, in a DFD, hierarchy works as a way to organize better the information and the communication. When you analyze a diagram, you see that the various levels are representing the degrees of details. It also shows the whole or a specific area of interest in the system. So, the users find facts easily. This is also very useful when they are making decisions or when they are doing any agreement.</p>", "image": "enpe8n3le03ob05re2img01.jpg", "time": "0", "id": 0}, {"text": "<p align=\"justify\"> There are different levels of hierarchy in data flow diagrams. I created one here. Look! In level 1, I drew the entire system; we call this the top-level. In level 2, I organized the expansion of processes; actually, this is representing just a part of the whole process. On the other hand, I didn't decompose these other processes because they are simple. In that case, they go in the bottom-level process. Remember, unless you have a complex process, you draw a new level.</p>", "image": "enpe8n3le03ob05re2img02.jpg", "time": "37000", "id": 1}, {"text": "<p align=\"justify\"> There are also some detailed facts you need to consider. First, unless you have more than 7 or 9 processes in a DFD, you need to include another level. In that case, it's necessary to group the other processes and to represent them smaller with just one process in a diagram that encompasses all. With that new grouped process, you organize another lower level which shows all the constituents. Unless you have more processes, you decompose the DFD, which you break down into subprocesses and it becomes another lower level. Finally, this is not a tendency, but unless a client doesn't understand all the information, you need to have the same hierarchy in the flow diagram.</p>", "image": "enpe8n3le03ob05re2img03.jpg", "time": "64500", "id": 2}], "audiosrc": "enpe8n3le03ob05re2aud01"}, "type": "slideshow"}], "title": "", "_data": [], "id": 1, "template_override": 1}], "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": ""}, {"type": "unit_name", "content": "Modelling Hierarchy in Data Flows"}, {"type": "position", "content": 5}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 3}, {"type": "level", "content": "A2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use when you talk about hierarchy in data flow diagrams."}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Describe common activities at work using short sentences in familiar spoken and written situations.  Interpret the requirements report to determine the technological needs in managing information, based on rules and protocols established by the company."}, {"type": "secondary_1", "content": "Participates in simple conversations or simulated situations about the communicative topics for this level through the appropriate use of simple pronunciation aspects, and grammar and vocabulary structures.  Recognizes simple ideas on requirement reports, tools for Object Oriented Programming, and other basic programming tools."}]}, {"type": "background_image", "content": "enpe8n3le03ob05re1img01.jpg"}, {"type": "target_word", "contents": [{"type": "name", "content": "bottom "}, {"type": "definition", "content": "the lowest part of something"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example:  On the other hand, I didn't decompose these other processes because they are simple. In that case, they go in the bottom-level process. "}, {"type": "audio", "content": "enpe8n3le03ob05aud01"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "decompose "}, {"type": "definition", "content": "to separate into different parts"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example:  Unless you have more processes, you decompose the DFD, which you break down into sub processes and it becomes another lower level. "}, {"type": "audio", "content": "enpe8n3le03ob05aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "degree "}, {"type": "definition", "content": "the steps in a process "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example:  When you analyze a diagram, you see that the various levels are representing the degrees of details."}, {"type": "audio", "content": "enpe8n3le03ob05aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "encompass "}, {"type": "definition", "content": "to have or include all the parts in just one thing"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example:  In that case, it's necessary to group the other processes and to represent them smaller with just one process in a diagram that encompasses all. "}, {"type": "audio", "content": "enpe8n3le03ob05aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "break down "}, {"type": "definition", "content": "to divide into parts"}, {"type": "part_speech", "content": "(phrasal verb)"}, {"type": "example", "content": "Example:  Unless you have more processes, you decompose the DFD, which you break down into sub processes and it becomes another lower level. "}, {"type": "audio", "content": "enpe8n3le03ob05aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "complex"}, {"type": "definition", "content": "consisting of many parts"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example:  Remember, unless you have a complex process, you draw a new level.   "}, {"type": "audio", "content": "enpe8n3le03ob05aud06"}]}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "a)\tRead some information about levels of hierarchy in DFD."}, {"type": "text", "content": "b)\tIn a poster, design and draw a data flow diagram describing hierarchy denotation."}, {"type": "text", "content": "c)\tPresent your work to your classmates and check pronunciation with your teacher. "}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "\u274f\tI explain how hierarchy works in DFD."}, {"type": "text", "content": "\u274f\tI describe different levels of hierarchy in DFD."}, {"type": "text", "content": "\u274f\tI talk about detail facts related to data flow diagrams."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Zero Conditional With Unless In Affirmative"}, {"type": "describer", "content": "You use the <span class=\"strong\"> zero conditional </span> to talk about a situation that is real and depends on one condition. You can use unless, which is also a conditional word similar to \u201cif\u201d, with this structure."}, {"type": "text", "content": "You use the <span class=\"strong\"> zero conditional </span> to talk about rules, routines, general truths, scientific facts, and cause and effect situations. <br/><br/>  This structure has two parts: the first explains a condition and the second explains the result, consequence, or direct relation to the first condition. Remember, both parts need to be in present simple and they always refer to true situations. You must separate the sentences with a comma. <br/><br/>  For <span class=\"strong\"> zero conditional</span>, these are the structures you can use. <br/><br/>  <div class=\"center_text\"> If + Present Simple + , + Present Simple </div> <br/><br/> Example: <br/> <span class=\"italic\">- <span class=\"strong\"> If </span> a diagram has a level, you use a basic graphic.</span> <br/><br/>  When the main clause comes first, you don't need a comma. <br/><br/>  <div class=\"center_text\"> Present Simple + If + Present Simple </div> <br/><br/> Example: <br/> <span class=\"italic\">- You use a basic graphic <span class=\"strong\"> if </span> a diagram has a level.</span> <br/><br/>  <span class=\"strong\"> Unless </span> is also a conditional word similar to <span class=\"strong\"> if </span>. When you use <span class=\"strong\"> unless </span>, you need a main clause and a subordinate clause. If you use <span class=\"strong\"> unless </span> before the main clause, remember to add a comma as well.  <br/><br/> Example: <br/>  <span class=\"italic\">- <span class=\"strong\"> Unless </span> you consider the levels, you can create a diagram. <br/> - You can send the information later <span class=\"strong\"> unless </span> you have time now.</span>"}, {"type": "example", "content": "Remember, unless you have a complex process, you draw a new level.  "}, {"type": "example", "content": "First, unless you have more than 7 or 9 processes in a DFD, you need to include another level."}, {"type": "example", "content": "Unless you have more processes, you decompose the DFD which you break down into sub processes and it becomes another lower level."}, {"type": "example", "content": "Finally, this is not a tendency. Unless a client doesn't understand all the information, you need to have the same hierarchy in the flow diagram. "}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "What does hierarchy mean?"}, {"type": "describer", "content": "Hierarchy refers to a scheme which organizes things or people according to their importance."}, {"type": "text", "content": "The hierarchy is the organization of several items or elements in a structure or system which are subordinated according to its values. The items can be located at the top, bottom, or middle of the structure depending on the inferiority and the superiority they represent. Likewise, the items can be depicted either vertically or diagonally. <br/><br/>  The word hierarchy is also associated to power; those elements which are at the top, have the power to control the rest of the structure. In our society it is possible to easily identify different organizations with this structure. For instance, the church hierarchy, the military hierarchy, the bureaucratic hierarchy, social hierarchy, and the corporate hierarchy. <br/><br/>  In programming, hierarchy diagrams are very important; specifically, data flow diagrams are represented in a chain of command scheme which is set to organize better the information and the communication, representing the degrees of details through several levels."}]}]}