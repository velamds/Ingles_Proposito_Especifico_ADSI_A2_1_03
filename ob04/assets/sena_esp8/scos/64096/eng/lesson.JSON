_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "allowed_attempts": 2}}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Listening"}]}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Listen to the audio. Click on the correct word to complete the sentence. "}]}]}, {"type": "RSLT", "stimuli_ids": [], "id": 10, "template_override": 1, "questions": [{"responses": [{"selected": 0, "id": 0, "correct": 0, "_data": [{"type": "text", "content": ""}]}, {"selected": 0, "id": 1, "correct": 1, "_data": [{"type": "text", "content": ""}]}], "_data": [{"type": "question", "contents": [{"type": "text", "content": ""}]}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"type": "group_name", "content": "Quiz"}]}, {"type": "feedback", "content": {"incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "allowed_attempts": 2}}]}, {"type": "DWS", "stimuli_ids": [], "id": 11, "template_override": 1, "questions": [{"responses": [{"selected": 0, "id": 0, "correct": 1, "_data": [{"type": "text", "content": ""}]}], "_data": [{"type": "question", "contents": [{"type": "pdf", "content": "enpe8n3le03ob04re7pdf01.pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"type": "text", "content": "The Directions of Flow and External Entities "}]}, {"type": "group", "contents": [{"type": "group_name", "content": "Take Away"}]}, {"type": "feedback", "content": {"incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}], "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "allowed_attempts": 2}}, {"type": "post_instructions", "contents": [{"type": "text", "content": "Instructions: Complete the following steps. Fill in the Self-Assessment."}]}, {"type": "learning_skills", "contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}]}]}], "type": "scholar", "stimuli": [{"id": 0, "type": "welcome", "contents": [{}], "template_override": 1, "_data": []}, {"type": "audio", "contents": [{"value": {"coverimg": "enpe8n3le03ob04re2img01.jpg", "images": [{"text": "To start, Direction of Flow represents the movement of information packets to or from different components that are illustrated by a hand arrow. In a diagram, you need to identify the arrows and names, which are both elements of a DFD. Remember that \u201cDFD\u201d is the acronym for Data Flow Diagram, and they have some differences. If you analyze it, you can identify that all parts have a name, but the flows don't have one because they represent the direction of flow.", "image": "enpe8n3le03ob04re2img01.jpg", "time": "0", "id": 0}, {"text": "Remember that a data flow has only one direction between symbols, but it can flow in both directions between a process and a data store. Additionally, if you don't make the difference between single arrows and two separate arrows with specific directions, it can be difficult to identify an update, read or write actions. For example, when a single arrow points towards the process, it depicts a 'read' action; in this case, the process does not alter the content of the store. Finally, an update contains both read and write actions, and you can have 2 arrows on both directions.", "image": "enpe8n3le03ob04re2img02.jpg", "time": "35000", "id": 1}, {"text": "On the other hand, an external entity can represent a person and an organization, both of them are outside the system, and they receive or send data from the system. if you don't want to get confused with the other parts, you can identify external entities with an alpha character. Also, you have to write both an identifier and the name of the entity. </br></br>\nFinally, when the external entity supplies data to the system, it represents a source as well, when it receives the data, it's a sink.  Anyway, both the sources and the sinks are external entities and parts of the DFD.", "image": "enpe8n3le03ob04re2img03.jpg", "time": "78000", "id": 2}], "audiosrc": "enpe8n3le03ob04re2aud01"}, "type": "slideshow"}], "title": "", "id": 1, "template_override": 1, "_data": []}], "_data": [{"type": "lab_options", "contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}]}], "id": 0}], "type": "sena", "_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": ""}, {"type": "unit_name", "content": "Data Flow Diagrams, Direction of Flow and External Entities"}, {"type": "position", "content": 4}, {"type": "origin", "content": "stub"}, {"type": "lesson", "content": 3}, {"type": "level", "content": "A2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use when you talk about Direction of Flow and External Entities."}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Describe common activities at work to a using short sentences in familiar spoken and written situations.  Make the result report from the analysis of the information system, based on the customer requirements, following established rules and protocols."}, {"type": "secondary_1", "content": "Participates in simple conversations or simulated situations about the communicative topics for this level through the appropriate use of simple pronunciation aspects, and grammar and vocabulary structures.  Recognizes simple ideas on requirement reports, tools for Object Oriented Programming, and other basic progamming tools."}]}, {"type": "background_image", "content": "enpe8n3le03ob04re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "a)\tRead information about the parts related to data flow diagrams."}, {"type": "text", "content": "b)\tCreate a poster in which you can describe and exemplify these parts."}, {"type": "text", "content": "c)\tPrepare an oral presentation using the zero conditional and conjunctions to explain the topic."}, {"type": "text", "content": "d)\tShare your work to your classmates and check pronunciation with your instructor. "}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "\u274f\tI explain the importance of direction of flow."}, {"type": "text", "content": "\u274f\tI talk about external entities."}, {"type": "text", "content": "\u274f\tI describe the parts related to data flow diagrams."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "packets "}, {"type": "definition", "content": "a part of a data or a small unit "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example:  Direction of Flow represents the movement of information packets to or from different components.  "}, {"type": "audio", "content": "enpe8n3le03ob04aud01"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "updates"}, {"type": "definition", "content": "new, old or current information which has movement in a data flow diagram "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example:  An update contains both read and write actions, and you can have 2 arrows on both directions."}, {"type": "audio", "content": "enpe8n3le03ob04aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "single "}, {"type": "definition", "content": "just one part or section"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: if you don't make the difference between single arrows and two separate arrows with specific directions, it can be difficult to identify an update. "}, {"type": "audio", "content": "enpe8n3le03ob04aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "towards "}, {"type": "definition", "content": "in direction of something"}, {"type": "part_speech", "content": "(preposition)"}, {"type": "example", "content": "Example:  When a single arrow points towards the process, it depicts a 'read' action."}, {"type": "audio", "content": "enpe8n3le03ob04aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "alter "}, {"type": "definition", "content": "to change or modify"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example:  In this case, the process does not alter the content of the store."}, {"type": "audio", "content": "enpe8n3le03ob04aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "get confused "}, {"type": "definition", "content": "to not understand something "}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example:  If you don't want to get confused with the other parts, you can identify external entities with an alpha character."}, {"type": "audio", "content": "enpe8n3le03ob04aud06"}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Zero Conditional With The If Sentence In Negative"}, {"type": "describer", "content": "You can use zero conditional in both negative and affirmative statements to talk about a situation that is a real fact."}, {"type": "text", "content": "You use this conditional to explain two situations that complement each other and that are always real. The first part of the conditional is called the main clause, this explains the condition. The second one explains the result, consequence or direct relation main clause. When the main clause is a negative statement it shows a negative condition. <br/><br/>  Remember to use the present simple form in negative after the \u201cif\u201d sentence. <br/><br/>  The structure is like this:<br/><br/> <div class=\"center_text\"> <span class=\"strong\"> If + Present Simple (negative form) + comma (,) + Present Simple </span></div><br/><br/>  Example: <br/> <span class=\"italic\"> -\tYou do not have to worry about the direction of the flow <span class=\"strong\"> if </span> you have a basic diagram. <br/> -\t<span class=\"strong\"> If </span> you <span class=\"strong\"> don't </span> analyze a Data Flow Diagram correctly, you don't recognize all the parts. </span><br/><br/>  <span class=\"italic\"> Remember that you separate the two clauses by a comma (, ) When you start with the if clause.</span> "}, {"type": "example", "content": "If you analyze it you can identify that all parts have a name but the flows don't have one, as they just represent the direction of flow."}, {"type": "example", "content": "If you don't make the difference between them; it's difficult to identify an update, read or write actions. "}, {"type": "example", "content": "If you don't want to get confused with the other parts, you can identify external entities with an alpha character."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Conjunctions, Both\u2026 And"}, {"type": "describer", "content": "Conjunctions are linking words that you can use to connect words or sentences. <span class=\"strong\"> Both </span>\u2026<span class=\"strong\"> and </span> are linking expressions. "}, {"type": "text", "content": "You can find different types of conjunctions, they can be coordinating, correlative or subordinating conjunctions.  You use \u201c<span class=\"italic\"><span class=\"strong\">and</span></span>\u201d , which is a coordinating conjunction that means in addition to,  when you want to connect words, phrases, or independent clauses. <br/><br/>  Example: <br/> <span class=\"italic\">- She wants to do a data flow diagram <span class=\"strong\"> and </span> a manual. <br/> - He is checking the DFD <span class=\"strong\"> and </span> she is working on the manual.</span>  <br/><br/> You can use \u201c<span class=\"italic\"><span class=\"strong\">both</span> </span>\u201d, which is a correlative conjunction, when you want to express that two things are included in a phrase. Additionally, in the same sentence you can use <span class=\"strong\"> both \u2026 and </span> when you want to mention the connection between two ideas. <br/><br/>  Example: <br/> <span class=\"italic\">-<span class=\"strong\"> Both </span>squares <span class=\"strong\"> and </span> triangles are shapes. <br/> -I bought <span class=\"strong\"> both </span> a software <span class=\"strong\"> </span> a new application.</span>"}, {"type": "table", "content": "{\"rows\":4,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Both\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Use\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Both with pronouns </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You can use both after a subject pronoun or an object pronoun\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> They both buy new programs.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Both with nouns </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"You can use both before a noun:\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> Both programmers are good. </span> \\t\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Both as a pronoun </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Both can be its own pronoun.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> The system engineers are in the house. Both are developing a new software.</span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "example", "content": "Also, you have to write both an identifier and the name of the entity."}, {"type": "example", "content": "Anyway both, the sources and the sinks are external entities and parts of the DFD."}]}]}